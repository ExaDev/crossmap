{
  "name": "crossmap",
  "description": "Bidirectional crosswalk codec: one rule document derives both encode and decode between two JSON shapes",
  "version": "0.8.0",
  "bin": {
    "crossmap": "./dist-cli/crossmap.mjs"
  },
  "dependencies": {
    "trilean": "1.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@exadev/eslint-config": "3.1.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "canonicalize": "5.1.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "files": [
    "dist",
    "dist-cli",
    "schemas"
  ],
  "keywords": [
    "codec",
    "crosswalk",
    "json",
    "json-schema",
    "transform",
    "zod"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/crossmap.git"
  },
  "scripts": {
    "_build": "tsdown && tsx scripts/generate-json-schema.ts",
    "_lint": "eslint . --fix --cache --cache-strategy content --max-warnings 0",
    "_lint:check": "eslint . --cache --cache-strategy content --max-warnings 0",
    "_test": "vitest run",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "lint:check": "turbo run _lint:check",
    "prepare": "husky",
    "prepublishOnly": "pnpm run lint:check && pnpm run build && pnpm run typecheck && pnpm run test && publint && attw --pack --profile esm-only",
    "prepush": "turbo run _prepush",
    "test": "turbo run _test",
    "typecheck": "turbo run _typecheck"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
