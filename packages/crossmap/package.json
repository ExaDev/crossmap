{
  "name": "crossmap",
  "description": "Bidirectional crosswalk codec: one rule document derives both encode and decode between two JSON shapes",
  "version": "0.12.4",
  "bin": {
    "crossmap": "./dist/cli.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "imports": {
    "#init": {
      "workerd": "./dist/init.workerd.js",
      "node": "./dist/init.node.js",
      "default": "./dist/init.browser.js"
    }
  },
  "keywords": [
    "codec",
    "crosswalk",
    "json",
    "json-schema",
    "transform",
    "wasm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/crossmap.git",
    "directory": "packages/crossmap"
  },
  "scripts": {
    "build": "sh ../../scripts/rust.sh xtask npm crossmap",
    "check:package": "publint && attw --pack --profile esm-only",
    "check:types": "tsc -p tsconfig.json",
    "test": "node scripts/test-packed.js"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
