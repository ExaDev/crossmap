from collections.abc import Iterable
from typing import Final, final

from crosswalk_codec._errors import CrosswalkIssue
from crosswalk_codec._json import JsonValue

VERSION: Final[str]

@final
class Crosswalk:
    @property
    def source(self) -> str: ...
    @property
    def target(self) -> str: ...
    @property
    def schema(self) -> str | None: ...
    def to_dict(self) -> JsonValue: ...
    def __eq__(self, other: object) -> bool: ...

@final
class CompiledCrosswalk:
    @property
    def crosswalk(self) -> Crosswalk: ...
    def encode(self, document: JsonValue) -> JsonValue: ...
    def decode(self, document: JsonValue) -> JsonValue: ...

def parse_crosswalk(document: JsonValue) -> Crosswalk: ...
def validate_crosswalk(crosswalk: Crosswalk) -> list[CrosswalkIssue]: ...
def compile_crosswalk(crosswalk: Crosswalk) -> CompiledCrosswalk: ...
def encode(crosswalk: Crosswalk, document: JsonValue) -> JsonValue: ...
def decode(crosswalk: Crosswalk, document: JsonValue) -> JsonValue: ...
def assert_round_trip(crosswalk: Crosswalk, samples: Iterable[JsonValue]) -> None: ...
def rule_sides(rule: JsonValue) -> tuple[list[str], list[str]]: ...
def format_syntax_error(messages: list[str]) -> str: ...
def format_structure_error(issues: list[tuple[int, str]]) -> str: ...
def format_rule_application_error(rule_index: int, path: str, detail: str) -> str: ...
def format_round_trip_mismatch(sample_index: int, path: str, detail: str) -> str: ...
def parse_path(path: str) -> list[dict[str, str | int]]: ...
def format_path(path: str) -> str: ...
def read_path(document: JsonValue, path: str) -> dict[str, list[JsonValue]] | None: ...
def is_url(argument: str) -> bool: ...
def run_command(args: list[str]) -> int: ...
def json_schema_text() -> str: ...
