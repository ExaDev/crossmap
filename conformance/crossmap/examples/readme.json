    {
      "crosswalk": {
        "oneWay": [
          {
            "direction": "encode",
            "from": "staffNotes",
            "op": "drop"
          },
          {
            "direction": "encode",
            "op": "default",
            "to": "origin",
            "value": "branch-library"
          }
        ],
        "rules": [
          {
            "from": "recordId",
            "op": "move",
            "to": "id"
          },
          {
            "from": "subjects",
            "op": "split",
            "separator": ";",
            "to": "topics"
          },
          {
            "from": "copies[].barcode",
            "op": "move",
            "to": "holdings[].barcode"
          },
          {
            "from": "digital",
            "op": "move",
            "to": "digital"
          },
          {
            "from": "licence.url",
            "op": "move",
            "to": "access.licenceUrl",
            "when": {
              "kind": "compare",
              "left": {
                "key": "digital",
                "kind": "reference"
              },
              "op": "eq",
              "right": {
                "kind": "booleanLiteral",
                "value": true
              }
            }
          }
        ],
        "source": "branch-library/record",
        "target": "catalogue/v2"
      },
      "direction": "encode",
      "document": {
        "copies": [
          {
            "barcode": "0041"
          },
          {
            "barcode": "0042"
          }
        ],
        "digital": true,
        "licence": {
          "url": "https://example.org/licence"
        },
        "recordId": "BL-1042",
        "staffNotes": "re-bind spine",
        "subjects": "maps;local history"
      },
      "expect": {
        "output": {
          "access": {
            "licenceUrl": "https://example.org/licence"
          },
          "digital": true,
          "holdings": [
            {
              "barcode": "0041"
            },
            {
              "barcode": "0042"
            }
          ],
          "id": "BL-1042",
          "origin": "branch-library",
          "topics": [
            "maps",
            "local history"
          ]
        }
      },
      "from": "README.md: A nested record with an optional block > encode(catalogue, record)",
      "id": "examples.readme.6",
      "kind": "run"
    },
